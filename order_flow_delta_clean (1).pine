//@version=5
indicator("Order Flow Delta - Simplified", shorttitle="OFD Simple", overlay=false)

// ============================================
// ⚙️ SETTINGS
// ============================================
deltaSmoothing = input.int(3, "Delta Smoothing", minval=1, maxval=10, group="Core")
signalThreshold = input.int(65, "Signal Threshold", minval=40, maxval=90, 
     tooltip="Score needed for signal (lower = more signals)", group="Core")
volumeMultiplier = input.float(1.3, "Volume Filter", minval=1.0, step=0.1, 
     tooltip="Volume must exceed MA by this multiplier", group="Core")

// ============================================
// 📊 DELTA CALCULATION
// ============================================
calculateDelta() =>
    barRange = high - low
    if barRange == 0
        0.0
    else
        closePosition = (close - low) / barRange  // 0 to 1: where close is in the bar
        buyVolume = volume * closePosition
        sellVolume = volume * (1 - closePosition)
        buyVolume - sellVolume

rawDelta = calculateDelta()
delta = ta.sma(rawDelta, deltaSmoothing)

// Volume filter
volumeMA = ta.sma(volume, 20)
isHighVolume = volume > volumeMA * volumeMultiplier

// Warm-up check
barsReady = bar_index >= 50

// ============================================
// 🎯 SIMPLIFIED SCORING SYSTEM
// ============================================
var float bullScore = 0.0
var float bearScore = 0.0

// Reset opposite score on direction change
if delta > 0
    bearScore := 0.0
if delta < 0
    bullScore := 0.0

// --- Component 1: Delta Strength (0-30 pts) ---
deltaStd = ta.stdev(delta, 30)
safeStd = math.max(nz(deltaStd), 0.0001)
strength = math.abs(delta) / safeStd
strengthPts = barsReady ? math.min(strength * 10.0, 30.0) : 0.0

// --- Component 2: Momentum (0-25 pts) ---
deltaROC = ta.change(delta, 2)
momentumPts = 0.0
if delta > 0 and deltaROC > 0
    momentumPts := 25.0
else if delta > 0 and deltaROC > deltaROC[1]
    momentumPts := 12.0
else if delta < 0 and deltaROC < 0
    momentumPts := 25.0
else if delta < 0 and deltaROC < deltaROC[1]
    momentumPts := 12.0

// --- Component 3: Volume Confirmation (0-25 pts) ---
volumePts = isHighVolume ? 25.0 : 0.0

// --- Component 4: Trend Alignment (0-20 pts) ---
deltaMA = ta.sma(delta, 14)
trendPts = 0.0
if delta > 0 and delta > deltaMA
    trendPts := 20.0
else if delta < 0 and delta < deltaMA
    trendPts := 20.0

// Accumulate scores
if delta > 0
    bullScore += strengthPts + momentumPts + volumePts + trendPts
if delta < 0
    bearScore += strengthPts + momentumPts + volumePts + trendPts

// Decay scores each bar
bullScore := math.max(bullScore * 0.85, 0.0)
bearScore := math.max(bearScore * 0.85, 0.0)

// Cap at 100
bullScore := math.min(bullScore, 100.0)
bearScore := math.min(bearScore, 100.0)

// ============================================
// 🎯 SIGNAL GENERATION
// ============================================
bullSignal = bullScore >= signalThreshold and bullScore[1] < signalThreshold and isHighVolume
bearSignal = bearScore >= signalThreshold and bearScore[1] < signalThreshold and isHighVolume

// Track position
var int position = 0  // 1 = long, -1 = short, 0 = flat
if bullSignal
    position := 1
if bearSignal
    position := -1
if position == 1 and bullScore < signalThreshold * 0.4
    position := 0
if position == -1 and bearScore < signalThreshold * 0.4
    position := 0

// ============================================
// 🎨 VISUALIZATION
// ============================================

// Colors
bullColor = #00E676
bearColor = #FF5252
bullColorFade = color.new(bullColor, 60)
bearColorFade = color.new(bearColor, 60)

// --- Histogram ---
histColor = delta > 0 ? 
     (delta > deltaMA ? bullColor : bullColorFade) : 
     (delta < deltaMA ? bearColor : bearColorFade)

plot(delta, "Delta", style=plot.style_histogram, color=histColor, linewidth=3)

// --- Delta MA line ---
plot(deltaMA, "Delta MA", color=color.new(#FFD700, 40), linewidth=1)

// --- Zero line ---
hline(0, "Zero", color=color.new(color.white, 80), linestyle=hline.style_solid)

// --- Score lines ---
plot(bullScore > 5 ? bullScore : na, "Bull Score", 
     color=color.new(bullColor, 50), linewidth=2)
plot(bearScore > 5 ? -bearScore : na, "Bear Score", 
     color=color.new(bearColor, 50), linewidth=2)

// Threshold reference
hline(signalThreshold, "Threshold", color=color.new(bullColor, 70), linestyle=hline.style_dotted)
hline(-signalThreshold, "Threshold", color=color.new(bearColor, 70), linestyle=hline.style_dotted)

// --- Signals ---
plotshape(bullSignal, "BUY", location=location.bottom,
     color=bullColor, style=shape.triangleup, size=size.normal, text="BUY")
plotshape(bearSignal, "SELL", location=location.top,
     color=bearColor, style=shape.triangledown, size=size.normal, text="SELL")

// --- Background for active position ---
bgcolor(position == 1 ? color.new(bullColor, 95) : 
        position == -1 ? color.new(bearColor, 95) : na)

// ============================================
// 📊 COMPACT INFO PANEL
// ============================================
var table panel = table.new(position.top_right, 2, 4,
     bgcolor=color.new(#1a1a2e, 20),
     frame_color=color.new(#ffffff, 80),
     frame_width=1)

if barstate.islast
    // Delta
    deltaK = delta / 1000
    table.cell(panel, 0, 0, "Δ", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, 0, str.tostring(deltaK, "#.#K"), 
         text_color=delta > 0 ? bullColor : bearColor, text_size=size.small)
    
    // Bull Score
    table.cell(panel, 0, 1, "↑", text_color=bullColor, text_size=size.small)
    table.cell(panel, 1, 1, str.tostring(math.round(bullScore)), 
         text_color=bullScore >= signalThreshold ? bullColor : color.gray, text_size=size.small)
    
    // Bear Score
    table.cell(panel, 0, 2, "↓", text_color=bearColor, text_size=size.small)
    table.cell(panel, 1, 2, str.tostring(math.round(bearScore)), 
         text_color=bearScore >= signalThreshold ? bearColor : color.gray, text_size=size.small)
    
    // Position
    posText = position == 1 ? "LONG" : position == -1 ? "SHORT" : "—"
    posColor = position == 1 ? bullColor : position == -1 ? bearColor : color.gray
    table.cell(panel, 0, 3, "", text_size=size.small)
    table.cell(panel, 1, 3, posText, text_color=posColor, text_size=size.normal)

// ============================================
// 🔔 ALERTS
// ============================================
alertcondition(bullSignal, "BUY Signal", "Order Flow Delta: BUY signal triggered")
alertcondition(bearSignal, "SELL Signal", "Order Flow Delta: SELL signal triggered")
