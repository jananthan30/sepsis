        "Creatinine",
        "Glucose",
        "Troponin",
        "Lipase",
        "Bilirubin",
        "Platelets",
        "Bicarbonate",
        "BUN",
        "Age",
        "Gender"
    ],
    "thresholds": {
        "screening_alert": 0.25,
        "critical_alert": 0.4
    }
}